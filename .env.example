# Copy to .env.local for local development. In production, set these as
# environment variables on the Netlify site instead.

# Auth0 tenant domain that signs presenters in (or your Auth0 custom domain). Required.
# The tenant needs an API whose identifier is this site's MCP endpoint:
# http://localhost:8888/mcp locally, https://cfp.cascadiajs.com/mcp in production.
AUTH0_DOMAIN=

# Mux API access token (Settings → Access Tokens, with Mux Video read and write
# permissions). Required for the in-agent and /record video recorder.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Global recording upload allocations. Set either to 0 to stop new uploads.
# Limits count attempts (including failures), not dollars.
VIDEO_UPLOADS_DAILY_LIMIT=100
VIDEO_UPLOADS_TOTAL_LIMIT=1000

# PostHog project API key (US Cloud), for web analytics on the site's pages and
# server-side CFP events. Optional: leave it empty to send nothing (the default locally).
POSTHOG_KEY=
